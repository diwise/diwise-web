package shared

func fallbackComponent(component templ.Component) templ.Component {
	if component == nil {
		return templ.NopComponent
	}

	return component
}

templ TableFooter(left, right templ.Component) {
	<div class="flex flex-col gap-4 border-t border-border/70 bg-card px-4 py-5 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:px-6">
		<div class="flex min-w-0 items-center">
			@fallbackComponent(left)
		</div>
		<div class="flex min-w-0 flex-wrap items-center">
			@fallbackComponent(right)
		</div>
	</div>
}
