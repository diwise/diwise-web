package smartcity

import . "github.com/diwise/frontend-toolkit"

templ ObjectPanel(l10n Localizer, object *ObjectViewModel) {
	<div class="rounded-2xl border border-border bg-card p-6">
		if object == nil {
			<p class="text-muted-foreground">{ l10n.Get("selectobject") }</p>
		} else {
			<h2 class="break-all font-heading text-xl font-bold">{ object.Name }</h2>
			<dl class="mt-4 flex flex-col gap-3 text-sm">
				<div class="flex flex-col gap-1">
					<dt class="font-bold">{ l10n.Get("type") }</dt>
					<dd>{ object.Type }</dd>
				</div>
				<div class="flex flex-col gap-1">
					<dt class="font-bold">{ l10n.Get("id") }</dt>
					<dd class="break-all">{ object.ID }</dd>
				</div>
			</dl>
		}
	</div>
}
