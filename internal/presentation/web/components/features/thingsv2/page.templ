package thingsv2

import (
	shared "github.com/diwise/diwise-web/internal/presentation/web/components/shared"
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/icon"
	. "github.com/diwise/frontend-toolkit"
)

templ ThingsV2Page(l10n Localizer, viewModel ThingsV2PageViewModel) {
	<div class="mx-auto flex w-full min-w-0 max-w-screen-2xl flex-col gap-6 md:gap-8">
		<header class="border-b border-border pb-6">
			@shared.SectionHeading(l10n.Get("thingsv2"), icon.Shapes(icon.Props{Size: 28, Class: "text-foreground"}))
		</header>
		<section class="flex min-w-0 flex-col gap-6">
			@Filters(l10n, viewModel)
			@ThingsV2DataList(l10n, viewModel)
		</section>
	</div>
}

templ ThingsV2DataList(l10n Localizer, viewModel ThingsV2PageViewModel) {
	<div id="tableOrMapV2" class="w-full min-w-0">
		if viewModel.MapView {
			<div class="overflow-hidden rounded-2xl border border-border bg-background shadow-sm">
				@ThingsV2Map(l10n, viewModel)
			</div>
		} else {
			@ThingsV2TableSection(l10n, viewModel)
		}
	</div>
}
