package thingsv2

import (
	"strings"

	shared "github.com/diwise/diwise-web/internal/presentation/web/components/shared"
	. "github.com/diwise/frontend-toolkit"
)

func ThingsV2Map(l10n Localizer, model ThingsV2PageViewModel) templ.Component {
	if !model.MapView {
		return templ.NopComponent
	}

	mapData := shared.NewMapData(62.3908, 17.3069)
	mapData.CurrentView = "thing-v2"
	return shared.Map("large", true, false, mapData, thingsV2ToMapFeature(l10n, model.Things))
}

func thingsV2ToMapFeature(l10n Localizer, things []ThingV2ViewModel) shared.FeatureCollection {
	features := make([]shared.Feature, 0, len(things))

	for _, thing := range things {
		var feature shared.Feature

		switch {
		case thing.HasLocation:
			feature = shared.NewFeature(shared.NewPoint(thing.Latitude, thing.Longitude))
			feature.AddProperty("latitude", thing.Latitude)
			feature.AddProperty("longitude", thing.Longitude)
		case thing.HasGeometry:
			feature = shared.NewPolygonFeature(thing.GeometryType, thing.Geometry)
		default:
			continue
		}

		feature.AddProperty("id", thing.ID)
		feature.AddProperty("type", strings.ToLower(thing.Category))
		feature.AddProperty("subtype", strings.ToLower(thing.TemplateID))
		feature.AddProperty("name", displayThingV2Name(thing))
		feature.AddProperty("category", thing.Category)

		if thing.HasPrimaryValue {
			feature.AddProperty("hasprimary", true)
			feature.AddProperty("primaryvalue", formatPrimaryValue(thing))
		} else {
			feature.AddProperty("hasprimary", false)
		}

		feature.AddProperty("text_category", l10n.Get("category"))
		feature.AddProperty("text_missingdata", l10n.Get("missingdata"))
		feature.AddProperty("text_moreinformation", l10n.Get("moreinformation"))
		feature.AddProperty("text_name", l10n.Get("name"))
		feature.AddProperty("text_position", l10n.Get("location"))
		feature.AddProperty("text_primary", l10n.Get("primary"))

		features = append(features, feature)
	}

	return shared.NewFeatureCollection(features)
}

func displayThingV2Name(thing ThingV2ViewModel) string {
	if strings.TrimSpace(thing.Name) != "" {
		return thing.Name
	}
	return thing.ID
}
