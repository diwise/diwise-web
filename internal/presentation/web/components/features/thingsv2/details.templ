package thingsv2

import (
	"fmt"
	"strings"

	shared "github.com/diwise/diwise-web/internal/presentation/web/components/shared"
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/button"
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/icon"
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/table"
	. "github.com/diwise/frontend-toolkit"
)

templ ThingV2DetailsPage(l10n Localizer, model ThingV2DetailsViewModel) {
	<div id="thing-v2-view" class="mx-auto flex w-full min-w-0 max-w-screen-2xl flex-col gap-6 md:gap-8">
		<div class="flex flex-col gap-4">
			<a
				href="/things-v2"
				hx-get="/things-v2"
				hx-target="#app-shell"
				hx-swap="outerHTML"
				hx-replace-url="true"
				class="inline-flex w-fit items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground"
			>
				<span aria-hidden="true">←</span>
				<span>{ l10n.Get("thingsv2") }</span>
			</a>
			<div class="flex min-w-0 flex-col gap-6 rounded-2xl border border-border bg-background p-5 shadow-sm sm:p-6 lg:flex-row lg:items-center lg:justify-between">
				<div class="min-w-0 space-y-3">
					<h1 class="break-words text-2xl font-bold font-heading tracking-tight text-foreground sm:text-3xl">{ displayThingV2Name(model.Thing) }</h1>
					<div class="flex flex-wrap items-center gap-2 text-sm">
						if model.Thing.Category != "" {
							@shared.BadgeChip(shared.BadgeChipProps{Label: model.Thing.Category})
						}
						<span class="break-all text-muted-foreground">{ model.Thing.Tenant }</span>
					</div>
				</div>
				if model.Thing.HasPrimaryValue {
					<div class="w-full shrink-0 rounded-xl bg-muted/40 p-4 tabular-nums lg:w-64">
						@ThingV2StatusCell(l10n, model.Thing)
					</div>
				}
				@button.Button(button.Props{
					Href:    fmt.Sprintf("/things-v2/%s?mode=edit", model.Thing.ID),
					Variant: button.VariantOutline,
					Class:   "shrink-0 rounded-xl px-4",
					Attributes: templ.Attributes{
						"hx-get":         fmt.Sprintf("/things-v2/%s?mode=edit", model.Thing.ID),
						"hx-target":      "#app-shell",
						"hx-swap":        "outerHTML",
						"hx-replace-url": "true",
					},
				}) {
					@icon.Pen(icon.Props{Class: "size-4"})
					{ l10n.Get("edit") }
				}
				@button.Button(button.Props{
					Variant: button.VariantDestructive,
					Class:   "shrink-0 rounded-xl px-4",
					Attributes: templ.Attributes{
						"hx-get":    fmt.Sprintf("/components/things-v2/%s/delete?tenant=%s", model.Thing.ID, model.Thing.Tenant),
						"hx-target": "#thing-v2-dialog-container",
						"hx-swap":   "innerHTML",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4"})
					{ l10n.Get("delete") }
				}
			</div>
		</div>
		<div id="thing-v2-dialog-container"></div>
		@ThingV2HistorySection(l10n, model)
		@ThingV2DetailsSensorsSection(l10n, model)
		@ThingV2RelatedThingsSection(l10n, model)
		@ThingV2DetailsValuesSection(l10n, model)
		<div class="grid min-w-0 grid-cols-1 items-start gap-6 xl:grid-cols-2">
			<div class="flex min-w-0 flex-col gap-6">
				@ThingV2DetailsPropertiesSection(l10n, model)
				if len(model.Metadata) > 0 {
					@ThingV2DetailsMetadataSection(l10n, model)
				}
			</div>
			<div class="flex min-w-0 flex-col gap-6">
				@ThingV2DetailsLocationSection(l10n, model)
			</div>
		</div>
	</div>
}

templ ThingV2DetailsValuesSection(l10n Localizer, model ThingV2DetailsViewModel) {
	@shared.DetailSectionCard(
		l10n.Get("values"),
		icon.Gauge(icon.Props{Size: 24, Class: "text-foreground"}),
	) {
		<div class="min-w-0 overflow-x-auto px-3 py-4 text-foreground sm:px-6">
			@table.Table(table.Props{Class: "min-w-[640px]"}) {
				@table.Header() {
					@table.Row() {
						@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("name") } }
						@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("measurementvalue") } }
						@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("quality") } }
						@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("observed") } }
					}
				}
				@table.Body() {
					if len(model.Values) == 0 {
						@table.Row() {
							@table.Cell(table.CellProps{Class: "px-6 py-10 text-center text-muted-foreground", Attributes: templ.Attributes{"colspan": "4"}}) {
								{ l10n.Get("missing") }
							}
						}
					} else {
						for _, value := range model.Values {
							@table.Row() {
								@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
									<span class="font-medium">{ displayV2ValueLabel(value) }</span>
								}
								@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
									<span class="whitespace-nowrap font-medium tabular-nums">{ formatV2Value(value) }</span>
								}
								@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
									@shared.BadgeChip(shared.BadgeChipProps{Label: fallbackV2Text(value.Quality)})
								}
								@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
									<span class="whitespace-nowrap text-sm tabular-nums text-muted-foreground">{ formatV2ObservedAt(value) }</span>
								}
							}
						}
					}
				}
			}
		</div>
	}
}

templ ThingV2DetailsPropertiesSection(l10n Localizer, model ThingV2DetailsViewModel) {
	@shared.DetailSectionCard(
		l10n.Get("details"),
		icon.Info(icon.Props{Size: 24, Class: "text-foreground"}),
	) {
		<div class="flex min-w-0 flex-col gap-4 break-words p-4 text-foreground sm:p-6">
			@shared.DetailList(thingV2DetailItems(l10n, model))
		</div>
	}
}

templ ThingV2DetailsSensorsSection(l10n Localizer, model ThingV2DetailsViewModel) {
	@shared.DetailSectionCard(
		l10n.Get("sensors"),
		icon.Rss(icon.Props{Size: 24, Class: "text-foreground"}),
	) {
		<div class="flex min-w-0 flex-col gap-3 p-4 text-foreground sm:p-6">
			if len(model.ConnectedSensors) == 0 {
				<span class="italic text-muted-foreground">{ l10n.Get("sensormissing") }</span>
			} else {
				for _, sensor := range model.ConnectedSensors {
					<div class="flex min-w-0 flex-col gap-1 rounded-xl border border-border px-4 py-3 sm:flex-row sm:items-center sm:gap-3">
						<a
							href={ string(templ.SafeURL(fmt.Sprintf("/sensors/%s", sensor.DeviceID))) }
							hx-get={ string(templ.SafeURL(fmt.Sprintf("/sensors/%s", sensor.DeviceID))) }
							hx-target="#app-shell"
							hx-swap="outerHTML"
							hx-replace-url="true"
							class="break-all font-medium underline underline-offset-4"
						>
							{ sensor.DeviceID }
						</a>
						<span class="text-sm text-muted-foreground">
							{ sensor.Input } ← { sensor.Object }/{ sensor.Resource }
						</span>
					</div>
				}
			}
		</div>
	}
}

templ ThingV2RelatedThingsSection(l10n Localizer, model ThingV2DetailsViewModel) {
	@shared.DetailSectionCard(
		l10n.Get("related"),
		icon.Icon("network")(icon.Props{Size: 24, Class: "text-foreground"}),
	) {
		<div class="min-w-0 overflow-x-auto p-4 text-foreground sm:p-6">
			if len(model.RelatedThings) == 0 {
				<span class="italic text-muted-foreground">{ l10n.Get("norelations") }</span>
			} else {
				@table.Table(table.Props{Class: "min-w-[640px]"}) {
					@table.Header() {
						@table.Row() {
							@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("name") } }
							@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("category") } }
							@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("primary") } }
							@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("organisation") } }
						}
					}
					@table.Body() {
						for _, related := range model.RelatedThings {
							@ThingV2Row(l10n, related)
						}
					}
				}
			}
		</div>
	}
}

templ ThingV2DetailsMetadataSection(l10n Localizer, model ThingV2DetailsViewModel) {	@shared.DetailSectionCard(
		l10n.Get("metadata"),
		icon.Tags(icon.Props{Size: 24, Class: "text-foreground"}),
	) {
		<div class="flex min-w-0 flex-col gap-4 break-words p-4 text-foreground sm:p-6">
			@shared.DetailList(thingV2MetadataItems(model))
		</div>
	}
}

templ ThingV2DetailsLocationSection(l10n Localizer, model ThingV2DetailsViewModel) {
	@shared.DetailSectionCard(
		l10n.Get("location"),
		icon.MapPin(icon.Props{Size: 24, Class: "text-foreground"}),
	) {
		<div class="flex w-full min-w-0 flex-col gap-4 p-4 text-foreground sm:p-6">
			if model.Thing.HasLocation {
				@shared.DetailList([]shared.DetailListItem{
					{Label: l10n.Get("latitude"), Value: formatCoordinate(model.Thing.Latitude)},
					{Label: l10n.Get("longitude"), Value: formatCoordinate(model.Thing.Longitude)},
				})
			}
			if model.Thing.HasLocation || model.Thing.HasGeometry {
				<div class="w-full overflow-hidden rounded-xl border border-border">
					@ThingsV2DetailsMap(l10n, model.Thing)
				</div>
			} else {
				<div class="italic text-muted-foreground">
					{ l10n.Get("missing") }
				</div>
			}
		</div>
	}
}

func thingV2DetailItems(l10n Localizer, model ThingV2DetailsViewModel) []shared.DetailListItem {
	items := []shared.DetailListItem{
		{Label: l10n.Get("template"), Value: model.Thing.TemplateID + " " + model.TemplateVersion},
		{Label: l10n.Get("category"), Value: fallbackV2Text(model.Thing.Category)},
		{Label: l10n.Get("organisation"), Value: fallbackV2Text(model.Thing.Tenant)},
		{Label: l10n.Get("revision"), Value: fmt.Sprintf("%d", model.Revision)},
	}
	if strings.TrimSpace(model.VariantID) != "" {
		version := strings.TrimSpace(model.VariantVersion)
		value := model.VariantID
		if version != "" {
			value += " " + version
		}
		items = append(items, shared.DetailListItem{Label: l10n.Get("variant"), Value: value})
	}
	return items
}

func thingV2MetadataItems(model ThingV2DetailsViewModel) []shared.DetailListItem {
	items := make([]shared.DetailListItem, 0, len(model.Metadata))
	for _, item := range model.Metadata {
		items = append(items, shared.DetailListItem{Label: item.Key, Value: fallbackV2Text(item.Value)})
	}
	return items
}

func displayV2ValueLabel(value ThingV2ValueViewModel) string {
	if strings.TrimSpace(value.Label) != "" {
		return value.Label
	}
	return value.PropertyID
}

func formatV2Value(value ThingV2ValueViewModel) string {
	if !value.HasValue {
		return "-"
	}
	if value.Unit != "" {
		return fmt.Sprintf("%g %s", value.Value, value.Unit)
	}
	return fmt.Sprintf("%g", value.Value)
}

func formatV2ObservedAt(value ThingV2ValueViewModel) string {
	if value.ObservedAt.IsZero() {
		return "-"
	}
	return value.ObservedAt.Format("2006-01-02 15:04")
}

func fallbackV2Text(value string) string {
	if strings.TrimSpace(value) == "" {
		return "-"
	}
	return value
}

func formatCoordinate(value float64) string {
	return fmt.Sprintf("%.6f", value)
}
