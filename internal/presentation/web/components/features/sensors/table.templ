package sensors

import (
	"fmt"
  	"net/url"

	shared "github.com/diwise/diwise-web/internal/presentation/web/components/shared"
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/button"
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/card"
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/dialog"
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/icon"
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/table"
	. "github.com/diwise/frontend-toolkit"
)

templ StatisticsCards(l10n Localizer, stats StatisticsViewModel) {
	<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
		@StatisticCard(l10n.Get("total"), stats.Total, icon.Rss(icon.Props{Size: 24, Class: "text-foreground"}))
		@StatisticCard(l10n.Get("active"), stats.Active, icon.Rss(icon.Props{Size: 24, Class: "text-[var(--status-online)]"}))
		@StatisticCard(l10n.Get("inactive"), stats.Inactive, icon.Rss(icon.Props{Size: 24, Class: "text-[var(--status-offline)]"}))
		@StatisticCard(l10n.Get("unknown"), stats.Unknown, icon.Rss(icon.Props{Size: 24, Class: "text-[var(--status-unknown)]"}))
	</div>
}

templ StatisticCard(title string, count int, leading templ.Component) {
	@card.Card(card.Props{Class: "rounded-2xl border-border/80 bg-card shadow-sm"}) {
		@card.Content(card.ContentProps{Class: "flex items-center gap-4 p-5"}) {
			<div class="flex size-12 items-center justify-center rounded-2xl bg-muted/60">
				@leading
			</div>
			<div class="flex flex-col">
				<div class="text-3xl font-bold font-heading text-foreground">{ fmt.Sprintf("%d", count) }</div>
				<div class="text-sm uppercase tracking-[0.2em] text-muted-foreground">{ title }</div>
			</div>
		}
	}
}

templ SensorsTableSection(l10n Localizer, viewModel SensorsPageViewModel) {
	{{ rightFooter := templ.Component(templ.NopComponent) }}
	if viewModel.Paging.PageLast > 1 {
		{{ rightFooter = shared.PagingControl(l10n, shared.PagingControlProps{
			PageIndex: viewModel.Paging.PageIndex,
			PageLast:  viewModel.Paging.PageLast,
			PageSize:  viewModel.Paging.PageSize,
			Query:     viewModel.Paging.Query,
			TargetURL: viewModel.Paging.TargetURL,
			TargetID:  viewModel.Paging.TargetID,
		}) }}
	}
	@shared.DataTableSection(
		shared.DataTableHeader(
			shared.DataTableSummary(fmt.Sprintf("%s %d %s %d", l10n.Get("show"), len(viewModel.Sensors), l10n.Get("sensorsof"), viewModel.Paging.TotalCount)),
			nil,
		),
		shared.TableFooter(
			shared.PageSizeControl(shared.PageSizeControlProps{
				FormID:    "page-size-form",
				Label:     l10n.Get("rowsPerPage"),
				TargetURL: viewModel.Paging.TargetURL,
				TargetID:  viewModel.Paging.TargetID,
				Include:   "#sensors-filters-form",
				PageSize:  viewModel.Paging.PageSize,
				Options:   []int{5, 10, 15, 50, 100},
			}),
			rightFooter,
		),
	) {
		@table.Table(table.Props{Class: "min-w-[860px]"}) {
			@table.Header() {
				@table.Row() {
					@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("online") } }
					@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("name") } }
					@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("status") } }
					@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("type") } }
					@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("deveui") } }
					@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("batterylevel") } }
					@table.Head(table.HeadProps{Class: "px-6 py-3"}) { { l10n.Get("lastseen") } }
					@table.Head(table.HeadProps{Class: "px-6 py-3 text-right"}) { <span class="sr-only">{ l10n.Get("actions") }</span> }
				}
			}
			@table.Body() {
				if len(viewModel.Sensors) == 0 {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "px-6 py-10 text-center text-muted-foreground", Attributes: templ.Attributes{"colspan": "8"}}) {
							{ l10n.Get("nosensors") }
						}
					}
				} else {
					for _, sensor := range viewModel.Sensors {
						@SensorRow(l10n, sensor, viewModel.DeviceProfiles, viewModel.Organisations)
					}
				}
			}
		}
	}
}

templ SensorRow(l10n Localizer, sensor SensorViewModel, deviceProfiles []string, organisations []string) {
	
	if sensor.Type == "unknown" {
		@shared.TableRow(shared.TableRowProps{}) {
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
			<div class="inline-flex items-center gap-2">
				<span class={ onlineIndicatorClass(sensor.Online) }></span>
				if sensor.Online {
					{ l10n.Get("online") }
				} else {
					{ l10n.Get("offline") }
				}
			</div>
		}
			@table.Cell(table.CellProps{Class: "px-6 py-3 align-top"}) {
				<span class="font-bold text-foreground">
					if sensor.Name != "" {
						{ sensor.Name }
					} else {
						{ sensor.DeviceID }
					}
				</span>
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				if sensor.Active {
					@shared.StatusBadge(shared.StatusBadgeProps{Tone: shared.StatusBadgeToneActive, Label: l10n.Get("active")})
				} else {
					@shared.StatusBadge(shared.StatusBadgeProps{Tone: shared.StatusBadgeToneInactive, Label: l10n.Get("inactive")})
				}
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				if sensor.Type != "" {
					{ sensor.Type }
				} else {
					{ "-" }
				}
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				if sensor.HasAlerts {
					<span class="font-semibold text-destructive">{ sensor.DevEUI }</span>
				} else {
					{ sensor.DevEUI }
				}
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				{ formatBattery(sensor.BatteryLevel) }
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3 text-muted-foreground"}) {
				if sensor.LastSeen.IsZero() {
					{ "-" }
				} else {
					{ sensor.LastSeen.Format("2006-01-02, 15:04") }
				}
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				@AddUnknownSensorAction(l10n, sensor)
			}
		}
	} else {
		@shared.ClickableTableRow(shared.ClickableTableRowProps{
			Href:    fmt.Sprintf("/sensors/%s", sensor.DeviceID),
			Target:  "#app-shell",
			Swap:    "outerHTML",
			Replace: true,
		}) {
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				<div class="inline-flex items-center gap-2">
					<span class={ onlineIndicatorClass(sensor.Online) }></span>
					if sensor.Online {
						{ l10n.Get("online") }
					} else {
						{ l10n.Get("offline") }
					}
				</div>
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3 align-top"}) {
				<span class="font-bold text-foreground">
					if sensor.Name != "" {
						{ sensor.Name }
					} else {
						{ sensor.DeviceID }
					}
				</span>
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				if sensor.Active {
					@shared.StatusBadge(shared.StatusBadgeProps{Tone: shared.StatusBadgeToneActive, Label: l10n.Get("active")})
				} else {
					@shared.StatusBadge(shared.StatusBadgeProps{Tone: shared.StatusBadgeToneInactive, Label: l10n.Get("inactive")})
				}
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				if sensor.Type != "" {
					{ sensor.Type }
				} else {
					{ "-" }
				}
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				if sensor.HasAlerts {
					<span class="font-semibold text-destructive">{ sensor.DevEUI }</span>
				} else {
					{ sensor.DevEUI }
				}
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {
				{ formatBattery(sensor.BatteryLevel) }
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3 text-muted-foreground"}) {
				if sensor.LastSeen.IsZero() {
					{ "-" }
				} else {
					{ sensor.LastSeen.Format("2006-01-02, 15:04") }
				}
			}
			@table.Cell(table.CellProps{Class: "px-6 py-3"}) {}
		}
	}
}

templ AddUnknownSensorAction(l10n Localizer, sensor SensorViewModel) {
	{{ requestURL := fmt.Sprintf("/components/sensors/create?sensorID=%s&name=%s", url.QueryEscape(sensor.DevEUI), url.QueryEscape(sensor.Name)) }}
	@button.Button(button.Props{
			Variant: button.VariantDefault,
			Size:    button.SizeSm,
			Class:   "rounded-xl px-3",
			Attributes: templ.Attributes{
					"hx-get":    requestURL,
					"hx-target": "#create-sensor-modal-container",
					"hx-swap":   "innerHTML",
			},
	}) {
			@icon.Plus(icon.Props{Class: "size-4"})
			Lägg till
	}
}

templ AddUnknownSensorDialog(l10n Localizer, sensor SensorViewModel, deviceProfiles []string, organisations []string) {
	{{ tenantFieldID := fmt.Sprintf("add-sensor-%s-tenant", sensor.DevEUI) }}
	{{ sensorTypeFieldID := fmt.Sprintf("add-sensor-%s-type", sensor.DevEUI) }}
	{{ dialogID := fmt.Sprintf("add-sensor-%s-dialog", sensor.DevEUI) }}
	{{ formID := fmt.Sprintf("add-sensor-%s-form", sensor.DevEUI) }}
	  @dialog.Dialog(dialog.Props{ID: dialogID, Open: true}) {
        @dialog.Content(dialog.ContentProps{
			Class:           "max-w-xl gap-0 overflow-hidden rounded-3xl border-border/80 bg-card/95 p-0 shadow-xl",
			HideCloseButton: true,
		}) {
			<form
				id={ formID }
				action="/components/sensors/create"
				method="post"
				class="flex flex-col"
				hx-post="/components/sensors/create"
				hx-target="#app-shell"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="sensorID" value={ sensor.DevEUI }/>
				<input type="hidden" name="name" value={ sensor.Name }/>
				<div class="border-b border-border/60 px-6 py-5">
					<h2 class="text-2xl font-bold font-heading text-foreground">Lägg till sensor</h2>
					<div class="mt-1 text-sm text-muted-foreground">{ sensor.DevEUI }</div>
				</div>
				<div class="grid gap-6 px-6 py-6">
					@shared.FormField(l10n.Get("organisation"), tenantFieldID) {
						<select
							id={ tenantFieldID }
							name="tenant"
							required
							class={ shared.NativeSelectClass() }
						>
							<option value="" selected disabled>{ l10n.Get("choose") }</option>
							for _, option := range organisationFieldOptions(organisations, "") {
								<option value={ option.Value }>{ option.Label }</option>
							}
						</select>
					}
					@shared.FormField(l10n.Get("sensortype"), sensorTypeFieldID) {
						<select
							id={ sensorTypeFieldID }
							name="sensorType"
							required
							class={ shared.NativeSelectClass() }
						>
							<option value="" selected disabled>{ l10n.Get("choose") }</option>
							for _, option := range sensorProfileOptions(deviceProfiles) {
								<option value={ option.Value }>{ option.Label }</option>
							}
						</select>
					}
				</div>
				<div class="flex items-center justify-end gap-3 border-t border-border/60 px-6 py-5">
					@dialog.Close(dialog.CloseProps{For: dialogID}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Class:   "rounded-xl px-4",
						}) {
							@icon.X(icon.Props{Class: "size-4"})
							{ l10n.Get("cancel") }
						}
					}
					@button.Button(button.Props{
						Type:    button.TypeSubmit,
						Variant: button.VariantDefault,
						Class:   "rounded-xl px-4",
					}) {
						@icon.Check(icon.Props{Class: "size-4"})
						{ l10n.Get("save") }
					}
				</div>
			</form>
		}
	}
}

func sensorProfileOptions(profiles []string) []shared.SelectBoxFieldOption {
	items := make([]shared.SelectBoxFieldOption, 0, len(profiles))
	for _, profile := range profiles {
		if profile == "unknown" {
			continue
		}
		items = append(items, shared.SelectBoxFieldOption{
			Value: profile,
			Label: profile,
		})
	}
	return items
}

func formatBattery(level int) string {
	switch {
	case level > 100:
		return fmt.Sprintf("%d mV", level)
	case level >= 0:
		return fmt.Sprintf("%d%%", level)
	default:
		return "-"
	}
}

func onlineIndicatorClass(online bool) string {
	if online {
		return "size-2.5 rounded-full bg-[var(--status-online)]"
	}
	return "size-2.5 rounded-full bg-[var(--status-offline)]"
}
