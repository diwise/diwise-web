package auth

import (
	"github.com/diwise/diwise-web/internal/presentation/web/components/shared/ui/toast"
	. "github.com/diwise/frontend-toolkit"
)

templ AccessDeniedToast() {
	@toast.Toast(toast.Props{
		Title:         "access denied",
		Variant:       toast.VariantError,
		Dismissible:   true,
		ShowIndicator: true,
		Icon:          true,
	})
}

templ AccessDeniedPage(asset AssetLoaderFunc) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link href={ asset("/css/diwise.css").Path() } rel="stylesheet"/>
			<title>diwise</title>
			@toast.Script()
		</head>
		<body class="min-h-screen bg-background text-foreground">
			@AccessDeniedToast()
		</body>
	</html>
}
